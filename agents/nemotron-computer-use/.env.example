# Copy to .env and fill in.

# Hugging Face read token: https://huggingface.co/settings/tokens
HF_TOKEN=

# Any long random string. Clients must send it as the API key.
# Generate one with: openssl rand -hex 32
VLLM_API_KEY=

# Printed by `modal deploy serve.py`, e.g. https://<workspace>--nemotron-vl-serve.modal.run
MODAL_ENDPOINT_URL=
